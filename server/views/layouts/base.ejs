<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — Sovereign' : 'Sovereign SSI Platform' %></title>
  <meta name="description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : 'Sovereign — Self-Sovereign Identity Platform' %>">

  <!-- Bootstrap 5.3 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <style>
    :root {
      --sv-primary: #6C63FF;
      --sv-primary-dark: #524ae0;
      --sv-accent: #00D9FF;
      --sv-bg: #0a0a1a;
      --sv-surface: #12122a;
      --sv-surface-2: #1a1a3e;
      --sv-border: #2a2a5a;
      --sv-text: #e0e0f0;
      --sv-text-muted: #8888aa;
    }

    body {
      background: var(--sv-bg);
      color: var(--sv-text);
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
    }

    /* ── Navbar ─────────────────────────────────────── */
    .sv-navbar {
      background: rgba(18, 18, 42, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--sv-border);
      padding: 0.75rem 0;
    }

    .sv-navbar .navbar-brand {
      font-weight: 700;
      font-size: 1.3rem;
      background: linear-gradient(135deg, var(--sv-primary), var(--sv-accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -0.5px;
    }

    .sv-navbar .nav-link {
      color: var(--sv-text-muted);
      font-weight: 500;
      font-size: 0.9rem;
      padding: 0.5rem 1rem;
      border-radius: 8px;
      transition: all 0.2s;
    }

    .sv-navbar .nav-link:hover,
    .sv-navbar .nav-link.active {
      color: var(--sv-accent);
      background: rgba(0, 217, 255, 0.08);
    }

    .sv-navbar .nav-link i { margin-right: 0.4rem; }

    /* ── Main Content ──────────────────────────────── */
    .sv-main {
      padding: 2rem 0;
      min-height: calc(100vh - 120px);
    }

    /* ── Cards ────────────────────────────────────── */
    .sv-card {
      background: var(--sv-surface);
      border: 1px solid var(--sv-border);
      border-radius: 16px;
      padding: 1.5rem;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .sv-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(108, 99, 255, 0.12);
    }

    /* ── Badges ───────────────────────────────────── */
    .sv-badge {
      padding: 0.3rem 0.7rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    .sv-badge-verified {
      background: rgba(16, 185, 129, 0.15);
      color: #10b981;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .sv-badge-method {
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 0.7rem;
      padding: 0.2rem 0.5rem;
    }

    .sv-badge-get    { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .sv-badge-post   { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
    .sv-badge-put    { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .sv-badge-patch  { background: rgba(168, 85, 247, 0.15); color: #a855f7; }
    .sv-badge-delete { background: rgba(239, 68, 68, 0.15);  color: #ef4444; }

    /* ── Footer ──────────────────────────────────── */
    .sv-footer {
      border-top: 1px solid var(--sv-border);
      padding: 1.5rem 0;
      color: var(--sv-text-muted);
      font-size: 0.85rem;
    }

    /* ── Print styles ────────────────────────────── */
    @media print {
      .sv-navbar, .sv-footer, .no-print { display: none !important; }
      body { background: #fff; color: #000; }
      .sv-card { border: 1px solid #ddd; box-shadow: none; }
    }

    /* ── Utilities ────────────────────────────────── */
    .text-accent { color: var(--sv-accent) !important; }
    .text-primary-sv { color: var(--sv-primary) !important; }
    .bg-surface { background: var(--sv-surface) !important; }
    .border-sv { border-color: var(--sv-border) !important; }
    .font-mono { font-family: 'SF Mono', 'Fira Code', monospace; }
  </style>
</head>
<body>

  <!-- ═══ NAV BAR ═══ -->
  <nav class="navbar navbar-expand-lg sv-navbar sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/portal">
        <i class="bi bi-shield-lock-fill me-2"></i>Sovereign
      </a>

      <button class="navbar-toggler border-0" type="button"
        data-bs-toggle="collapse" data-bs-target="#portalNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="portalNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'portal' ? 'active' : '' %>"
               href="/portal">
              <i class="bi bi-grid-1x2-fill"></i>Issuer Portal
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'api-docs' ? 'active' : '' %>"
               href="/api-docs">
              <i class="bi bi-journal-code"></i>API Docs
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/api/health" target="_blank">
              <i class="bi bi-heart-pulse-fill"></i>Health
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="http://localhost:5173" target="_blank">
              <i class="bi bi-rocket-takeoff-fill"></i>Dashboard
            </a>
          </li>

          <% /* ── Session User Info (Lectures 37-40) ─────────────── */ %>
          <% if (typeof user !== 'undefined' && user) { %>
            <li class="nav-item ms-lg-3">
              <span class="nav-link" style="color: var(--sv-accent); cursor: default;">
                <i class="bi bi-person-circle me-1"></i><%= user.email %>
              </span>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/portal/logout" style="color: #ef4444;">
                <i class="bi bi-box-arrow-right"></i>Logout
              </a>
            </li>
          <% } else { %>
            <li class="nav-item ms-lg-3">
              <a class="nav-link" href="/portal/login">
                <i class="bi bi-box-arrow-in-right"></i>Login
              </a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- ═══ MAIN CONTENT ═══ -->
  <main class="sv-main">
    <div class="container">

      <%/* ── Flash Messages (Lectures 37-40) ───────────────────── */%>
      <% if (typeof flash !== 'undefined' && flash.success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"
             style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25); color: #10b981; border-radius: 10px;">
          <i class="bi bi-check-circle-fill me-2"></i><%= flash.success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <% if (typeof flash !== 'undefined' && flash.error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert"
             style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.25); color: #ef4444; border-radius: 10px;">
          <i class="bi bi-exclamation-circle-fill me-2"></i><%= flash.error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <%- body %>
    </div>
  </main>

  <!-- ═══ FOOTER ═══ -->
  <footer class="sv-footer">
    <div class="container d-flex justify-content-between align-items-center">
      <span>&copy; 2026 Sovereign SSI Platform — Lectures 29-32</span>
      <span class="font-mono" style="font-size: 0.75rem; color: var(--sv-text-muted);">
        Server-Side Rendered with EJS
      </span>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
