<%- include('layouts/base', { body: `

<div class="mb-4 no-print">
  <a href="/portal" class="btn btn-sm btn-outline-light">
    <i class="bi bi-arrow-left me-1"></i>Back to Portal
  </a>
</div>

<!-- ── Report Header ──────────────────────────────────── -->
<div class="sv-card mb-4">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div>
      <small class="text-muted text-uppercase" style="letter-spacing: 1px; font-size: 0.7rem;">
        Verifiable Credential Report
      </small>
      <h2 class="fw-bold mt-1 mb-2">${credential.type}</h2>
      <div class="d-flex gap-3 flex-wrap">
        <span class="d-flex align-items-center gap-1">
          <i class="bi bi-building text-accent"></i>
          <small>${credential.issuer}</small>
        </span>
        <span class="d-flex align-items-center gap-1">
          <i class="bi bi-person-fill text-primary-sv"></i>
          <small>${credential.holderName || 'Unknown Holder'}</small>
        </span>
        <span class="sv-badge ${
          credential.status === 'verified' ? 'sv-badge-verified' :
          credential.status === 'expiring' ? '" style="background:rgba(245,158,11,0.15);color:#f59e0b;border:1px solid rgba(245,158,11,0.3);' :
          credential.status === 'revoked' ? '" style="background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.3);' :
          '" style="background:rgba(59,130,246,0.15);color:#3b82f6;border:1px solid rgba(59,130,246,0.3);'
        }">
          <i class="bi bi-${
            credential.status === 'verified' ? 'check-circle-fill' :
            credential.status === 'expiring' ? 'exclamation-triangle-fill' :
            credential.status === 'revoked' ? 'x-circle-fill' : 'clock-fill'
          } me-1"></i>
          ${credential.status.charAt(0).toUpperCase() + credential.status.slice(1)}
        </span>
      </div>
    </div>
    <button onclick="window.print()" class="btn no-print"
            style="background: var(--sv-primary); color: white;">
      <i class="bi bi-printer-fill me-2"></i>Print Report
    </button>
  </div>
</div>

<div class="row g-4">
  <!-- ── Claims ────────────────────────────────────────── -->
  <div class="col-lg-7">
    <div class="sv-card h-100">
      <h5 class="fw-bold mb-3">
        <i class="bi bi-list-check text-accent me-2"></i>Credential Claims
      </h5>
      <div class="table-responsive">
        <table class="table table-dark table-hover mb-0" style="--bs-table-bg: transparent;">
          <thead>
            <tr style="border-bottom: 2px solid var(--sv-border);">
              <th style="color: var(--sv-text-muted); font-size: 0.8rem; font-weight: 600;">FIELD</th>
              <th style="color: var(--sv-text-muted); font-size: 0.8rem; font-weight: 600;">VALUE</th>
              <th style="color: var(--sv-text-muted); font-size: 0.8rem; font-weight: 600; text-align: center;">ZKP</th>
            </tr>
          </thead>
          <tbody>
            ${(credential.claims || []).map(claim => \`
            <tr style="border-color: var(--sv-border);">
              <td class="fw-medium">\${claim.label}</td>
              <td><code style="color: var(--sv-accent); font-size: 0.85rem;">\${claim.value}</code></td>
              <td class="text-center">
                \${claim.zkpCapable
                  ? '<i class="bi bi-shield-fill-check" style="color: #10b981;" title="ZKP-capable"></i>'
                  : '<i class="bi bi-dash text-muted"></i>'}
              </td>
            </tr>
            \`).join('')}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ── Metadata ──────────────────────────────────────── -->
  <div class="col-lg-5">
    <div class="sv-card h-100">
      <h5 class="fw-bold mb-3">
        <i class="bi bi-info-circle-fill text-primary-sv me-2"></i>Credential Metadata
      </h5>

      <div class="d-flex flex-column gap-3">
        <div>
          <small class="text-muted d-block mb-1">Credential ID</small>
          <code class="text-accent" style="font-size: 0.85rem;">${credential.id}</code>
        </div>

        <div>
          <small class="text-muted d-block mb-1">Issue Date</small>
          <span>${credential.issueDate || 'N/A'}</span>
        </div>

        ${credential.expiryDate ? \`
        <div>
          <small class="text-muted d-block mb-1">Expiry Date</small>
          <span>\${credential.expiryDate}</span>
        </div>
        \` : ''}

        ${credential.metadata ? \`
        <div>
          <small class="text-muted d-block mb-1">Issuer DID</small>
          <code style="font-size: 0.7rem; word-break: break-all; color: var(--sv-accent);">
            \${credential.metadata.issuerDID || 'N/A'}
          </code>
        </div>

        <div>
          <small class="text-muted d-block mb-1">Schema</small>
          <code style="font-size: 0.75rem; color: var(--sv-text-muted);">
            \${credential.metadata.schemaID || 'N/A'}
          </code>
        </div>

        <div>
          <small class="text-muted d-block mb-1">Proof Type</small>
          <span class="sv-badge" style="background:rgba(108,99,255,0.15);color:var(--sv-primary);">
            \${credential.metadata.proofType || 'N/A'}
          </span>
        </div>
        \` : ''}
      </div>
    </div>

    <!-- ── Verification Stamp ──────────────────────────── -->
    <div class="sv-card mt-3 text-center"
         style="border-color: ${credential.status === 'verified' ? 'rgba(16,185,129,0.3)' : 'var(--sv-border)'};">
      <i class="bi bi-patch-check-fill" style="font-size: 2.5rem; color: ${
        credential.status === 'verified' ? '#10b981' :
        credential.status === 'expiring' ? '#f59e0b' : '#ef4444'
      };"></i>
      <h6 class="fw-bold mt-2 mb-1">${
        credential.status === 'verified' ? 'Credential Verified' :
        credential.status === 'expiring' ? 'Credential Expiring' :
        credential.status === 'revoked' ? 'Credential Revoked' : 'Pending Verification'
      }</h6>
      <small class="text-muted">
        Generated ${new Date().toISOString().split('T')[0]} — Sovereign SSI Platform
      </small>
    </div>
  </div>
</div>

` }) %>
