<%- include('layouts/base', { body: `

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
  <div>
    <h1 class="h3 fw-bold mb-1">
      <i class="bi bi-journal-code text-accent me-2"></i>API Reference
    </h1>
    <p class="text-muted mb-0">Server-rendered documentation — ${routes.length} endpoints available</p>
  </div>
  <div class="d-flex gap-2">
    <span class="sv-badge" style="background:var(--sv-surface-2);color:var(--sv-text);">
      <i class="bi bi-hdd-rack-fill me-1"></i>Base URL: http://localhost:3001
    </span>
  </div>
</div>

<!-- ── Route Groups ───────────────────────────────── -->
${(() => {
  const groups = {};
  routes.forEach(r => {
    const group = r.group || 'Other';
    if (!groups[group]) groups[group] = [];
    groups[group].push(r);
  });

  return Object.entries(groups).map(([group, groupRoutes]) => \`
  <div class="sv-card mb-4">
    <div class="d-flex align-items-center gap-2 mb-3">
      <h5 class="fw-bold mb-0">\${group}</h5>
      <span class="badge rounded-pill" style="background:var(--sv-surface-2);color:var(--sv-text-muted);font-size:0.7rem;">
        \${groupRoutes.length} endpoints
      </span>
    </div>

    <div class="table-responsive">
      <table class="table table-dark mb-0" style="--bs-table-bg: transparent;">
        <thead>
          <tr style="border-bottom: 2px solid var(--sv-border);">
            <th style="color: var(--sv-text-muted); font-size: 0.75rem; width: 80px;">METHOD</th>
            <th style="color: var(--sv-text-muted); font-size: 0.75rem;">PATH</th>
            <th style="color: var(--sv-text-muted); font-size: 0.75rem;">DESCRIPTION</th>
          </tr>
        </thead>
        <tbody>
          \${groupRoutes.map(route => \`
          <tr style="border-color: var(--sv-border);">
            <td>
              <span class="sv-badge sv-badge-method sv-badge-\${route.method.toLowerCase()}">
                \${route.method}
              </span>
            </td>
            <td>
              <code style="color: var(--sv-accent); font-size: 0.85rem;">\${route.path}</code>
            </td>
            <td class="text-muted" style="font-size: 0.85rem;">\${route.description}</td>
          </tr>
          \`).join('')}
        </tbody>
      </table>
    </div>
  </div>
  \`).join('');
})()}

<!-- ── Response Format Example ─────────────────────── -->
<div class="sv-card">
  <h5 class="fw-bold mb-3">
    <i class="bi bi-braces-asterisk text-primary-sv me-2"></i>Response Format
  </h5>
  <p class="text-muted mb-3">All API responses follow a consistent JSON structure:</p>
  <pre class="p-3 rounded" style="background: var(--sv-surface-2); border: 1px solid var(--sv-border); overflow-x: auto;"><code style="color: var(--sv-text); font-size: 0.85rem;">{
  "success": true,
  "count": 8,
  "data": [ ... ]
}</code></pre>
  <div class="mt-3">
    <small class="text-muted">
      <i class="bi bi-info-circle me-1"></i>
      Error responses include <code>success: false</code> with structured error details including
      <code>code</code>, <code>message</code>, <code>requestId</code>, and <code>timestamp</code>.
    </small>
  </div>
</div>

` }) %>
