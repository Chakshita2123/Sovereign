# ── Sovereign Backend Environment Variables ──
# Copy this file to .env:  cp .env.example .env

# Server — use 3001 to avoid conflicts with other local services on 3000
PORT=3001
HOST=localhost
NODE_ENV=development   # development | production

# MongoDB Atlas (Lectures 33-36) — free M0 tier at mongodb.com/atlas
# 1. Create cluster → Database Access → add user
# 2. Network Access → allow 0.0.0.0/0 for dev
# 3. Paste connection string below
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/sovereign

# Sessions (Lectures 37-40) — used to sign the session cookie
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# JWT Authentication (Lectures 41-44) — used to sign API access tokens
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-different-long-random-string

# Admin Portal Login (Lectures 37-40) — hardcoded admin for Day 5
# Day 6 replaces this with a full User model + Passport.js
# Default password: admin123
# Generate hash:  node -e "require('bcrypt').hash('yourpassword', 12).then(h => console.log(h))"
ADMIN_EMAIL=admin@sovereign.dev
ADMIN_PASS_HASH=$2b$12$REPLACE_WITH_YOUR_HASH

